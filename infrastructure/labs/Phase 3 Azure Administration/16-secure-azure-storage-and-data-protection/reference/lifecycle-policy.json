{
    "rules": [
        {
            "enabled": true,
            "name": "delete-old-document-versions",
            "type": "Lifecycle",
            "definition": {
                "actions": {
                    "version": {
                        "delete": {
                            "daysAfterCreationGreaterThan": 30
                        }
                    }
                },
                "filters": {
                    "blobTypes": [
                        "blockBlob"
                    ],
                    "prefixMatch": [
                        "documents/"
                    ]
                }
            }
        }
    ]
}